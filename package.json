{
  "name": "dsh-billing-compass",
  "version": "1.1.2",
  "description": "DeepSeek 计费罗盘：在输入框下方的统计条里显示 DeepSeek 余额、官网用量与消费、按模型花费、智能体团队/子代理消费，以及本次运行的实时费用估算。",
  "type": "module",
  "license": "MIT",
  "author": "wwu328763-netizen",
  "repository": {
    "type": "git",
    "url": "https://github.com/wwu328763-netizen/dsh-billing-compass.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "billing",
    "usage",
    "cost"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node tools/smoke.mjs"
  }
}
